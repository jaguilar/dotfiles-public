#!/bin/bash

# Ensure Flatpak is installed before trying to override
if command -v flatpak &> /dev/null; then
    echo "Setting Flatpak filesystem overrides for PrusaSlicer..."
    flatpak override --user com.prusa3d.PrusaSlicer --filesystem=~/.config/PrusaSlicer
else
    echo "Flatpak not found, skipping override."
fi